# Server-side secrets for the training cycle (docker compose services cycle and scheduler). Copy to
# .env (ignored by Git) and chmod 600. DEPLOY.md, section 7; never in the Worker or the repository.
# R2 S3 API endpoint of the Cloudflare account: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Token 1, an R2 Account API token: Object Read only, applied to the zap-events bucket only.
R2_EVENTS_ACCESS_KEY_ID=
R2_EVENTS_SECRET_ACCESS_KEY=
# Token 2, an R2 Account API token: Object Read & Write, applied to the zap-models and zap-public buckets only.
R2_PUBLISH_ACCESS_KEY_ID=
R2_PUBLISH_SECRET_ACCESS_KEY=
# Fine-grained GitHub token, resource owner AndreiLud, only the repository AndreiLud/zap, repository
# permission Contents: Read and write; used to attach open data to Releases (DEPLOY.md, section 10).
GITHUB_RELEASES_TOKEN=
# Local S3 stand-in for the cycle's tests only (docker compose --profile cycle-dev up -d minio); at least 8 characters each.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Open data package (training cycle): stays off until the owner switches it on, after 1,000 valid
# human matches; the first release is the owner's own command (DEPLOY.md, section 10).
OPEN_DATA_ENABLED=false
