{
  "name": "zap",
  "version": "0.1.0",
  "private": true,
  "description": "Truco in the browser against an AI that learns from the people who play it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "test": "vitest run",
    "test:engine": "vitest run engine",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tests/docs/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p tests/integration/tsconfig.json",
    "bench:engine": "node engine/bench/hands-per-second.ts",
    "build:web": "vite build --config web/vite.config.ts && node web/scripts/prerender.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:perf": "playwright test --config tests/perf/playwright.config.ts",
    "shots": "playwright test --config tests/shots/playwright.config.ts",
    "og": "node tools/og/shoot.mjs",
    "sfx": "sh tools/audio/make-shouts.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.65.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "openskill": "5.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "preact": "11.2.0"
  }
}
